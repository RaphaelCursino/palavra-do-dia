# Exemplo: configure estas variáveis no terminal antes de iniciar a aplicação.
PALAVRA_DO_DIA_DATABASE=palavra-do-dia.sqlite3
PALAVRA_DO_DIA_TIMEZONE=America/Sao_Paulo
PALAVRA_DO_DIA_ENV=development
# Obrigatória quando PALAVRA_DO_DIA_ENV=production.
PALAVRA_DO_DIA_SECRET_KEY=gere-uma-chave-aleatoria-e-persistente
